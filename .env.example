PORT=
MONGODB_URI=
JWT_SECRET=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application type)
GOOGLE_CLIENT_ID=

# ── Gmail SMTP (newsletter delivery) ─────────────────────────────────────────
# Used by nodemailer to send newsletter emails (new books, articles, welcome).
#
# Setup:
#   1. Go to your Google Account → Security → 2-Step Verification (enable it)
#   2. Go to Security → App Passwords
#   3. Select app: "Mail", device: "Other" → give it a name (e.g. "BookStore")
#   4. Google generates a 16-character password — paste it in GMAIL_APP_PASSWORD
#
# IMPORTANT: use the App Password, NOT your regular Gmail password.
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Used to build links in emails (unsubscribe, explore books, etc.)
FRONTEND_URL=