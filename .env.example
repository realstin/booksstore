PORT=
MONGODB_URI=
JWT_SECRET=

# ── Google OAuth ────────────────────────────────────────────────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application type)
# Add your frontend origin to "Authorized JavaScript origins"
# You do NOT need the client secret for this ID-token verification flow
GOOGLE_CLIENT_ID=

# ── Email sending (Resend — works on Render free tier) ───────────────────────
# Render blocks outbound SMTP (Gmail port 587) — Resend uses HTTPS/port 465
# which is never blocked.
#
# Setup (free, no credit card):
#   1. Sign up at https://resend.com
#   2. Go to API Keys → Create API key → copy it here
#   3. Free plan: use EMAIL_FROM = "BookStore <onboarding@resend.dev>"
#      (no domain needed). To send from your own domain, verify it in Resend.
RESEND_API_KEY=
EMAIL_FROM=BookStore <onboarding@resend.dev>

# ── App URL ──────────────────────────────────────────────────────────────────
# Base URL of the frontend — used to build verification and reset links in emails
# Development : http://localhost:5173
# Production  : https://bookstowa.vercel.app  (or your actual domain)
FRONTEND_URL=http://localhost:5173
