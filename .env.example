PORT=
MONGODB_URI=
JWT_SECRET=

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application type)
GOOGLE_CLIENT_ID=

# ── Resend SMTP (email verification & password reset) ─────────────────────────
# Render free tier blocks Gmail SMTP (port 587). Resend uses port 465 which
# is never blocked. Free plan: 3,000 emails/month, 100/day, no credit card.
#
# Setup:
#   1. Sign up at https://resend.com (free)
#   2. Go to API Keys → Create API key → paste it below
#   3. EMAIL_FROM: use "BookStore <onboarding@resend.dev>" on the free plan
#      (no domain verification needed). To send from your own domain,
#      verify it in the Resend dashboard and update EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=BookStore <onboarding@resend.dev>

# ── Frontend URL ──────────────────────────────────────────────────────────────
# Used to build the verification and reset links embedded in emails.
# Development : http://localhost:5173
# Production  : https://your-app.vercel.app  ← your real Vercel URL
FRONTEND_URL=http://localhost:5173
