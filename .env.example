PORT=
MONGODB_URI=
JWT_SECRET=

# ── Google OAuth ────────────────────────────────────────────────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application type)
# Add your frontend origin to "Authorized JavaScript origins"
# You do NOT need the client secret for this ID-token verification flow
GOOGLE_CLIENT_ID=

# ── Gmail SMTP (email verification & password reset) ────────────────────────
# GMAIL_USER      — your full Gmail address, e.g. yourname@gmail.com
# GMAIL_APP_PASSWORD — 16-char App Password (NOT your regular Gmail password)
#   Generate one at: Google Account → Security → 2-Step Verification → App passwords
#   App name can be anything, e.g. "BookStore"
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── App URL ──────────────────────────────────────────────────────────────────
# Base URL of the frontend — used to build verification and reset links in emails
# Development : http://localhost:5173
# Production  : https://bookstowa.vercel.app  (or your actual domain)
FRONTEND_URL=http://localhost:5173
